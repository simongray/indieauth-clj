{:paths ["src"]

 ;; Clojure 1.11 is the floor, and the tests run on it unless an alias says
 ;; otherwise. wary-fetch sends the requests, html-pieces parses a page once,
 ;; microformats-clj reads its h-card or h-app, and data.json reads and
 ;; writes JSON on the JVM, which JavaScript does by itself.
 :deps  {org.clojure/clojure           {:mvn/version "1.11.4"}
         org.clojure/data.json         {:mvn/version "2.5.2"}
         dk.simongray/wary-fetch       {:mvn/version "0.2.0"}
         dk.simongray/html-pieces      {:mvn/version "0.3.0"}
         dk.simongray/microformats-clj {:mvn/version "0.1.0"}}

 :aliases
 {;; clojure -X:test
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -M:cljs compile test  (the tests in Node)
  :cljs {:extra-paths   ["test"]
         :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
         :extra-deps    {thheller/shadow-cljs {:mvn/version "3.5.3"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -M:nrepl  (a REPL for development, with the tests)
  :nrepl {:extra-paths ["test"]
          :extra-deps  {nrepl/nrepl {:mvn/version "1.7.0"}}
          :jvm-opts    ["-Djdk.attach.allowAttachSelf"]
          :main-opts   ["-m" "nrepl.cmdline"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
